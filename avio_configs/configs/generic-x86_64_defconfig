BR2_x86_64=y

BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="/app/toolchains/generic-x86_64"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="x86_64-buildroot-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_GCC_14=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_6=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set

BR2_SYSTEM_DHCP="eth0"

# Linux headers same as kernel, 6.6 series
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AVIO_PATH)/board/common/kernel.config"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.147"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_AVIO_PATH)/board/generic-x86_64/linux.config"
BR2_LINUX_KERNEL_LZ4=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Rootfs overlay
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AVIO_PATH)/board/common/rootfs_overlay $(BR2_EXTERNAL_AVIO_PATH)/board/generic-x86_64/rootfs_overlay"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_AVIO_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# Compiler cache (persisted/restored by the CI pipeline to cut build time)
# Capped size + reduced parallelism to avoid memory pressure from WebKitGTK's
# heavy unified-source compiles fighting ccache for RAM on CI runners
BR2_CCACHE=y
BR2_CCACHE_DIR="/app/.ccache"
BR2_CCACHE_INITIAL_SETUP="-M 2G"
BR2_JLEVEL=3

# Enable compressed kernel module support
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_LIBGTK3=y
BR2_PACKAGE_LIBGTK3_WAYLAND=y
BR2_PACKAGE_WEBKITGTK=y
BR2_PACKAGE_LIBRTLSDR=y
BR2_PACKAGE_LIBDRM=y

# Needed by iris/radeonsi unconditionally, and by crocus in Mesa 26.x for
# its CLC-based shader precompilation (crocus now shares that code path
# with iris) -- without this, Kconfig silently drops iris/radeonsi (their
# "depends on" isn't met) and crocus fails at meson configure time with
# "Feature llvm cannot be disabled: CLC requires LLVM".
BR2_PACKAGE_MESA3D_LLVM=y

BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y

# GStreamer + PulseAudio client lib (avio links libgstapp-1.0.so.0 and
# libpulse.so.0 directly; the pulse plugin selects pulseaudio for us and
# lets pipewire's pipewire-pulse bridge those calls to pipewire/wireplumber)
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_PULSE=y

# xkb data (cage/libxkbcommon need /usr/share/X11/xkb even without X11)
BR2_PACKAGE_XKEYBOARD_CONFIG=y

# Boot splash screen
BR2_PACKAGE_PSPLASH=y
BR2_PACKAGE_PSPLASH_PROGRESS_BAR=y
BR2_PACKAGE_PSPLASH_FULL_SCREEN=y

# GPU / EGL / Wayland stack (needed by webkitgtk and cage)
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# Wayland kiosk compositor
BR2_PACKAGE_CAGE=y

BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
# rootfs is the 2nd partition on the MBR disk (1=EFI, 2=rootfs, 3=persist)
BR2_TARGET_GRUB2_BOOT_PARTITION="hd0,msdos2"

# Packages to bundle
BR2_PACKAGE_NANO=y
BR2_PACKAGE_RNG_TOOLS=y
BR2_PACKAGE_HAVEGED=y
BR2_PACKAGE_BLUEZ_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_UMTPRD=y    

# Other options
BR2_TARGET_GENERIC_HOSTNAME="avio"
BR2_TARGET_GENERIC_ROOT_PASSWD="password"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="console"

# Filesystem / image
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW=n
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="700M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AVIO_PATH)/board/generic-x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_AVIO_PATH)/board/generic-x86_64/post-image.sh"
