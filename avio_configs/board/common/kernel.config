# Add f_accessory function for usb gadget
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_ACC=y

# Build the DRM/KMS GPU drivers directly into the kernel instead of as
# modules -- this rootfs uses minimal eudev (BR2_ROOTFS_DEVICE_CREATION_
# DYNAMIC_EUDEV), which doesn't auto-load kernel modules from device tree
# compatibles the way full systemd-udev does. Left as modules, nothing
# ever loads vc4/v3d, so Cage finds zero GPUs and can never start.
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y

# Disable bnep in bluetooth
CONFIG_BT_BNEP=n

# Disable some kernel debugging options
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_DEBUG_FS=n
CONFIG_KGDB=n
CONFIG_DEBUG_MEMORY_INIT=n
CONFIG_FTRACE=n
CONFIG_SLUB_DEBUG=n
