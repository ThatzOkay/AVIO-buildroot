# <file system>	<mount pt>	<type>	<options>		<dump>	<pass>
# /boot and /persist are mounted by /etc/init.d/S02mount-partitions
# instead of here -- BusyBox's mount can't resolve LABEL=/PARTUUID= on
# this system (no udev database at mount -a time), and the disk's device
# name varies by controller, so a static fstab entry can't express it.
/dev/root	/		ext4	ro,noauto		0	1
proc		/proc		proc	defaults		0	0
devpts		/dev/pts	devpts	defaults,gid=5,mode=620,ptmxmode=0666	0	0
tmpfs		/dev/shm	tmpfs	mode=0777		0	0
tmpfs		/tmp		tmpfs	mode=1777		0	0
tmpfs		/run		tmpfs	mode=0755,nosuid,nodev	0	0
sysfs		/sys		sysfs	defaults		0	0
